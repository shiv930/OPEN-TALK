      "updated": 1787707622366,
      "link": null,
      "locked": false,
      "text": "export const refreshTokenController = async (req, res) => {\n  try {\n    const { refreshToken } = req.cookies;\n    if (!refreshToken) {\n      return res.status(401).json({ success: false, message: \"Refresh token missing\"\n});\n    }\n\n    const isBlacklisted = await redis.get(`bearer:refreshToken:${refreshToken}`);\n    if (isBlacklisted) {\n      return res.status(403).json({ success: false, message: \"Invalid refresh token\" });\n    }\n\n    const newAccessToken = generateToken(req.user._id, \"15min\");\n    const newRefreshToken = generateToken(req.user._id, \"2d\");\n\n    res.cookie(\"accessToken\", newAccessToken, {\n      httpOnly: true,\n      maxAge: 15 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    res.cookie(\"refreshToken\", newRefreshToken, {\n      httpOnly: true,\n      maxAge: 2 * 24 * 60 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    return res.status(200).json({\n      success: true,\n      message: \"Tokens refreshed successfully\",\n      accessToken: newAccessToken,\n      refreshToken: newRefreshToken,\n    });\n  } catch (error) {\n    return res.status(500).json({ success: false, message: \"Internal server error\",\nerror: error.message });\n  }\n};\n",
      "fontSize": 7.619479492196274,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export const refreshTokenController = async (req, res) => {\n  try {\n    const { refreshToken } = req.cookies;\n    if (!refreshToken) {\n      return res.status(401).json({ success: false, message: \"Refresh token missing\" });\n    }\n\n    const isBlacklisted = await redis.get(`bearer:refreshToken:${refreshToken}`);\n    if (isBlacklisted) {\n      return res.status(403).json({ success: false, message: \"Invalid refresh token\" });\n    }\n\n    const newAccessToken = generateToken(req.user._id, \"15min\");\n    const newRefreshToken = generateToken(req.user._id, \"2d\");\n\n    res.cookie(\"accessToken\", newAccessToken, {\n      httpOnly: true,\n      maxAge: 15 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    res.cookie(\"refreshToken\", newRefreshToken, {\n      httpOnly: true,\n      maxAge: 2 * 24 * 60 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    return res.status(200).json({\n      success: true,\n      message: \"Tokens refreshed successfully\",\n      accessToken: newAccessToken,\n      refreshToken: newRefreshToken,\n    });\n  } catch (error) {\n    return res.status(500).json({ success: false, message: \"Internal server error\", error: error.message });\n  }\n};\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
