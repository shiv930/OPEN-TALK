      "updated": 1787738218891,
      "link": null,
      "locked": false,
      "text": "export const deleteUserController = async (req, res) => {\n  try {\n    const { email } = req.body;\n    if (!email) {\n      return res.status(400).json({\n        success: false,\n        message: \"Email is required\",\n      });\n    }\n\n    const user = await userModel.findOneAndDelete({ email });\n    if (!user) {\n      return res.status(404).json({\n        success: false,\n        message: \"User not found\",\n      });\n    }\n\n    return res.status(200).json({\n      success: true,\n      message: \"User deleted successfully\",\n    });\n  } catch (error) {\n    return res.status(500).json({\n      success: false,\n      message: \"Internal server error\",\n      error: error.message,\n    });\n  }\n};\n",
      "fontSize": 11.41360858480319,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export const deleteUserController = async (req, res) => {\n  try {\n    const { email } = req.body;\n    if (!email) {\n      return res.status(400).json({\n        success: false,\n        message: \"Email is required\",\n      });\n    }\n\n    const user = await userModel.findOneAndDelete({ email });\n    if (!user) {\n      return res.status(404).json({\n        success: false,\n        message: \"User not found\",\n      });\n    }\n\n    return res.status(200).json({\n      success: true,\n      message: \"User deleted successfully\",\n    });\n  } catch (error) {\n    return res.status(500).json({\n      success: false,\n      message: \"Internal server error\",\n      error: error.message,\n    });\n  }\n};\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TSeXVA9Wj49nVNHBU8IYf",
      "type": "text",
      "x": 1548.2764569867948,
