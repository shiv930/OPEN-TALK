      "updated": 1787737600993,
      "link": null,
      "locked": false,
      "text": "export const regenerateAccessToken = async (req, res) => {\n  try {\n    const { refreshToken } = req.cookies;\n    if (!refreshToken) {\n      return res.status(401).json({\n        success: false,\n        message: \"Refresh token not found\",\n      });\n    }\n\n    // Check if refresh token is blacklisted\n    const isBlacklisted = await\nredis.get(`bearer:refreshToken:${refreshToken}`);\n    if (isBlacklisted) {\n      return res.status(403).json({\n        success: false,\n        message: \"Refresh token is invalid\",\n      });\n    }\n\n    const newAccessToken = generateToken(req.user._id, \"15min\");\n\n    res.cookie(\"accessToken\", newAccessToken, {\n      httpOnly: true,\n      maxAge: 15 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    return res.status(200).json({\n      success: true,\n      message: \"Access token regenerated successfully\",\n      accessToken: newAccessToken,\n    });\n  } catch (error) {\n    return res.status(500).json({\n      success: false,\n      message: \"Internal server error\",\n      error: error.message,\n    });\n  }\n};\n",
      "fontSize": 8.757082622457567,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export const regenerateAccessToken = async (req, res) => {\n  try {\n    const { refreshToken } = req.cookies;\n    if (!refreshToken) {\n      return res.status(401).json({\n        success: false,\n        message: \"Refresh token not found\",\n      });\n    }\n\n    // Check if refresh token is blacklisted\n    const isBlacklisted = await redis.get(`bearer:refreshToken:${refreshToken}`);\n    if (isBlacklisted) {\n      return res.status(403).json({\n        success: false,\n        message: \"Refresh token is invalid\",\n      });\n    }\n\n    const newAccessToken = generateToken(req.user._id, \"15min\");\n\n    res.cookie(\"accessToken\", newAccessToken, {\n      httpOnly: true,\n      maxAge: 15 * 60 * 1000,\n      secure: false,\n      sameSite: \"strict\",\n    });\n\n    return res.status(200).json({\n      success: true,\n      message: \"Access token regenerated successfully\",\n      accessToken: newAccessToken,\n    });\n  } catch (error) {\n    return res.status(500).json({\n      success: false,\n      message: \"Internal server error\",\n      error: error.message,\n    });\n  }\n};\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "HWmnoX0KTS_VP3NJ6Ewep",
